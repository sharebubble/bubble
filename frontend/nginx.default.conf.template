upstream backend {
    server ${BACKEND_HOST};
}

server {
    include mime.types;
    types {
        text/javascript js mjs;
    }

    listen 8888 default_server;
    listen [::]:8888 default_server;

    server_name  "~^(?<subdomain>[^\.]*)\.?(?<domain>.*)$";

    client_max_body_size 500m;
    index index.html index.htm;

    server_tokens off;

    # add default headers
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache, no-store, max-age=0, must-revalidate";
    add_header Expires "0";
    add_header Pragma "no-cache";

    root /usr/share/nginx/html;

    location / {
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/sentry-tunnel/(?<sentry_project_id>\d+)/ {
        proxy_ssl_server_name on;
        proxy_ssl_name o4511038158209024.ingest.sentry.io;

        resolver 8.8.8.8 ipv6=off;
        set $sentry_host "o4511038158209024.ingest.de.sentry.io";

        proxy_set_header Host $sentry_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass https://$sentry_host/api/$sentry_project_id/envelope/;

        # Buffering tweaks for better performance
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # The service worker must never be served from a long-lived cache: a stale
    # /sw.js keeps controlling the app forever, so no new build can ever take
    # over. The exact-match location is what keeps it out of the immutable
    # asset rule below (a regex location would otherwise win for a .js file).
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, max-age=0, must-revalidate";
        add_header Expires "0";
    }

    # Manifest changes with the app, and browsers re-read it on install.
    location = /manifest.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, max-age=0, must-revalidate";
        types { }
        default_type application/manifest+json;
    }

    # App icons carry no content hash, so the immutable rule below would pin a
    # replaced logo or maskable icon on installed devices for a year. Must stay
    # ahead of that rule: regex locations are matched in order.
    location ~ ^/(favicon\.ico|logo\.png|logo-512\.png|icon-192\.png|icon-512\.png)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Cache static assets. Safe only because Vite content-hashes its output;
    # unhashed files in public/ are matched too, hence the exceptions above.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* /(api|accounts|admin|caldav) {
        proxy_pass http://backend;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_redirect off;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        client_max_body_size 100M;
    }

    # Environment configuration endpoint
    location = /env-config.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Type "application/javascript";
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        return 200 'window._env_ = {
  VITE_SENTRY_DSN: "${VITE_SENTRY_DSN}",
  VITE_SENTRY_ENVIRONMENT: "${VITE_SENTRY_ENVIRONMENT}"
};';
    }

    location /static/ {
        alias /usr/share/nginx/static/;
    }
    location /media/ {
        alias /usr/share/nginx/media/;
    }
    location /healthz {
        return 200 "OK";
    }
}
