{
  "name": "bubble-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright end-to-end tests for Bubble (release gate against main.sharebubble.org)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/.bin/playwright test",
    "test:smoke": "node --env-file-if-exists=.env node_modules/.bin/playwright test --grep @smoke",
    "test:regression": "node --env-file-if-exists=.env node_modules/.bin/playwright test --grep @regression",
    "test:ui": "node --env-file-if-exists=.env node_modules/.bin/playwright test --ui",
    "report": "playwright show-report",
    "list": "node --env-file-if-exists=.env node_modules/.bin/playwright test --list",
    "wait-for-version": "node --env-file-if-exists=.env scripts/wait-for-version.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
