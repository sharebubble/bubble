# Copy to e2e/.env for local runs (git-ignored). Names only — no real secrets here.

# Target under test. Defaults to the stage/release-gate env.
E2E_BASE_URL=https://main.sharebubble.org
# API origin — defaults to E2E_BASE_URL if unset.
# E2E_API_URL=https://main.sharebubble.org

# Namespace tag for data this run creates (CI sets this from the run id).
# E2E_RUN_ID=local-dev

# Multi-user pool credentials (one pair per role: owner, renterA, renterB, admin).
E2E_OWNER_USERNAME=
E2E_OWNER_PASSWORD=
E2E_RENTERA_USERNAME=
E2E_RENTERA_PASSWORD=
E2E_RENTERB_USERNAME=
E2E_RENTERB_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Version guard tuning (optional).
# E2E_WAIT_TIMEOUT_MS=600000
# E2E_WAIT_INTERVAL_MS=10000
